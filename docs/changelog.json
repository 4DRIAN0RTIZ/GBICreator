[{"version":"v0.2.0","message":null,"commits":[{"id":"fcba284c6fcc527745fbb83d0d952141105a4493","message":"vincular métricas de valor y control a su política de origen","body":"Cada política pasa a tener id propio y cada métrica un origenPoliticaId\nobligatorio, en vez de tres listas de strings sueltas sin relación entre\nsí. Toda métrica nueva exige elegir de qué política nace; el canvas y el\npanel de edición muestran un badge compartido (P1, P2...) entre la\npolítica y las métricas que la miden. Datos guardados con el modelo\nanterior se migran automáticamente y quedan marcadas como sin origen\nhasta reasignarlas.","footers":[],"group":"Features","breaking_description":null,"breaking":false,"scope":null,"links":[],"author":{"name":"ditr4drian","email":"adrian.ortiz@ditra.mx","timestamp":1789147399},"committer":{"name":"ditr4drian","email":"adrian.ortiz@ditra.mx","timestamp":1789147399},"conventional":true,"merge_commit":false,"statistics":{"files_changed":10,"additions":362,"deletions":56},"extra":null,"github":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitlab":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"gitea":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"bitbucket":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"azure_devops":{"username":null,"pr_author":null,"pr_title":null,"pr_number":null,"pr_numbers":[],"pr_labels":[],"is_first_time":false},"raw_message":"feat: vincular métricas de valor y control a su política de origen\n\nCada política pasa a tener id propio y cada métrica un origenPoliticaId\nobligatorio, en vez de tres listas de strings sueltas sin relación entre\nsí. Toda métrica nueva exige elegir de qué política nace; el canvas y el\npanel de edició